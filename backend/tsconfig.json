{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "lib": [
      "ES2022",
      "DOM"
    ],

    "types": [
      "node"
    ],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "sourceMap": true,

    "declaration": false,
    "declarationMap": false,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmitOnError": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "src/seed-users.ts",
    "src/test-db.ts"
  ]
}