# EKIP backend environment template
# Copy this file to .env and replace placeholders.
# Never commit the real .env file.

# ---------------------------------------------------------
# Runtime
# ---------------------------------------------------------
NODE_ENV=development
PORT=4000

# Set true only when EKIP is behind a trusted reverse proxy/load balancer
# and you want Express to trust the first proxy hop.
TRUST_PROXY=false

# Comma-separated exact frontend origins allowed by CORS.
# Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------
# Neon / PostgreSQL
# ---------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server secret. Never expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Private storage bucket used for EKIP documents.
SUPABASE_DOCUMENTS_BUCKET=documents

# ---------------------------------------------------------
# Ollama
# ---------------------------------------------------------
# Local Ollama:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# For a hosted backend, this must point to an Ollama instance reachable
# from that backend. Do not expose an unauthenticated Ollama service
# directly to the public internet.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:4b

# EKIP's pgvector schema expects 768-dimensional embeddings.
OLLAMA_EMBEDDING_DIMENSION=768

OLLAMA_EMBEDDING_TIMEOUT_MS=60000
OLLAMA_CHAT_TIMEOUT_MS=120000

# ---------------------------------------------------------
# Public portfolio demo access
# ---------------------------------------------------------
# Keep false unless you intentionally want the one-click demo buttons enabled.
DEMO_MODE_ENABLED=false

# These credentials stay on the backend only.
# Do NOT expose them as VITE_* variables.
DEMO_ADMIN_EMAIL=demo.admin@ekip.app
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

DEMO_MANAGER_EMAIL=demo.manager@ekip.app
DEMO_MANAGER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

DEMO_EMPLOYEE_EMAIL=demo.employee@ekip.app
DEMO_EMPLOYEE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
