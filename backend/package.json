{
  "name": "ekip-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Knowledge Intelligence Platform Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:runtime": "node scripts/verify-production.mjs",
    "verify:phase7": "npm run build && npm test",
    "prisma:generate": "prisma generate",
    "demo:setup": "tsx src/setup-demo-users.ts",
    "demo:cleanup": "tsx src/cleanup-demo-users.ts"
  },
  "keywords": [
    "ekip",
    "enterprise",
    "knowledge",
    "rag",
    "semantic-search",
    "ai"
  ],
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.115.0",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
